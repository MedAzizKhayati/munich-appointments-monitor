# Required: target SPA URL
APPOINTMENT_URL="https://stadt.muenchen.de/buergerservice/terminvereinbarung.html#/services/10176294/locations/1094898"

# API-first availability polling
APPOINTMENT_API_BASE_URL="https://www48.muenchen.de/buergeransicht/api/citizen/available-appointments-by-office/"
AVAILABLE_DAYS_API_BASE_URL="https://www48.muenchen.de/buergeransicht/api/citizen/available-days-by-office/"
LOOKAHEAD_DAYS=30
SERVICE_COUNT=1
REQUEST_TIMEOUT_MS=15000

# Telegram notifier (optional)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron expression for internal scheduler mode
CRON_EXPRESSION="*/5 * * * *"

# Runtime mode: once | scheduler
RUN_MODE=once

# Retry behavior
MAX_RETRIES=3

# Paths
STATE_FILE_PATH=data/state.json
LOG_FILE_PATH=logs/notifications.log
